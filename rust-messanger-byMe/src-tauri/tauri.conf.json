{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rust-messanger-byme",
  "version": "0.1.0",
  "identifier": "com.copm11.rust-messanger-byme",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "rust-messanger-byme",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/attachments/**/*",
          "$RESOURCE/**",
          "C:/Users/User2/RustroverProjects/YURA_VUE-main/rust-messanger-byMe/attachment/**",
          "C:/Users/User2/RustroverProjects/YURA_VUE-main/rust-messanger-byMe/src-tauri/attachment/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
